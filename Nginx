# ============================================================
# Nginx - postitech.com
# Static site (mirrors the restoquest.app server pattern)
# Deploy path: /var/www/postitech.com
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name postitech.com www.postitech.com;
    root /var/www/postitech.com;
    index index.html;

    # Logs
    access_log /var/log/nginx/postitech.com-access.log;
    error_log  /var/log/nginx/postitech.com-error.log;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json
                application/xml+rss application/atom+xml image/svg+xml text/xml;

    # --- Security headers (equivalent of the .htaccess rules; Nginx ignores .htaccess) ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # www -> non-www (run this AFTER certbot has issued a cert for both hosts)
    if ($host = www.postitech.com) {
        return 301 https://postitech.com$request_uri;
    }

    # Cache static assets
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|webp|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # HTML - always revalidate
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # robots.txt / sitemap.xml
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
    location = /sitemap.xml {
        allow all;
        log_not_found off;
        access_log off;
    }

    # Prevent directory listing
    autoindex off;

    # --- Do NOT expose local authoring/dev tooling in production ---
    # admin.html + app.py are a local content-publishing tool (Flask on 127.0.0.1:5000).
    # They should not even be uploaded to the server, but this blocks them if they are.
    location ~* ^/(admin\.html|app\.py|post_generator\.py|index - copia\.html)$ {
        deny all;
        return 404;
    }

    # Block dotfiles (.git, .env, .htaccess, etc.)
    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}

# After DNS is live, run:
#   sudo certbot --nginx -d postitech.com -d www.postitech.com
# Certbot will rewrite this file: add a "listen 443 ssl" server block with the
# certificate paths, and an HTTP->HTTPS redirect on port 80. Re-check the
# www -> non-www block still works after that edit.
