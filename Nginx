# ============================================================
# Nginx - postisolutions.com
# Static site (mirrors the restoquest.app server pattern)
# Deploy path: /var/www/postisolutions.com
# ============================================================

# ------------------------------------------------------------
# Cloudflare real-IP restoration: postisolutions.com is proxied
# through Cloudflare (orange cloud), so without this, every request
# in the access log / $remote_addr shows a Cloudflare edge IP
# instead of the real visitor. List current at:
# https://www.cloudflare.com/ips/  (re-check occasionally, it changes)
# ------------------------------------------------------------
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

server {
    listen 80;
    listen [::]:80;
    server_name postisolutions.com www.postisolutions.com;
    root /var/www/postisolutions.com;
    index index.html;

    # Logs
    access_log /var/log/nginx/postisolutions.com-access.log;
    error_log  /var/log/nginx/postisolutions.com-error.log;

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json
                application/xml+rss application/atom+xml image/svg+xml text/xml;

    # --- Security headers (equivalent of the .htaccess rules; Nginx ignores .htaccess) ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # www -> non-www (run this AFTER certbot has issued a cert for both hosts)
    if ($host = www.postisolutions.com) {
        return 301 https://postisolutions.com$request_uri;
    }

    # Cache static assets
    location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|webp|woff|woff2|ttf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # HTML - always revalidate
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # robots.txt / sitemap.xml
    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }
    location = /sitemap.xml {
        allow all;
        log_not_found off;
        access_log off;
    }

    # Prevent directory listing
    autoindex off;

    # --- Do NOT expose local authoring/dev tooling in production ---
    # admin.html + app.py are a local content-publishing tool (Flask on 127.0.0.1:5000).
    # They should not even be uploaded to the server, but this blocks them if they are.
    location ~* ^/(admin\.html|app\.py|post_generator\.py|index - copia\.html)$ {
        deny all;
        return 404;
    }

    # Block dotfiles (.git, .env, .htaccess, etc.)
    location ~ /\. {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }
}

# After DNS is live, run:
#   sudo certbot --nginx -d postisolutions.com -d www.postisolutions.com
# Certbot will rewrite this file: add a "listen 443 ssl" server block with the
# certificate paths, and an HTTP->HTTPS redirect on port 80. Re-check the
# www -> non-www block still works after that edit.
